<%- include('header', { title: 'Новая заявка' }) %>
<div class="row justify-content-center"><div class="col-lg-7 col-12">
  <h1 class="h2 mb-3">Новая заявка</h1>
  <% if (errors.length) { %><div class="alert alert-danger"><ul class="mb-0"><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div><% } %>
  <form method="POST" action="/create" class="card card-body">
    <div class="mb-3">
      <label class="form-label" for="room">Помещение</label>
      <select class="form-select" id="room" name="room_id" required>
        <option value="">Выберите помещение</option>
        <% rooms.forEach(room => { %><option value="<%= room.id %>" <%= String(form.room_id || '') === String(room.id) ? 'selected' : '' %>><%= room.name %> (<%= room.capacity %> чел.)</option><% }) %>
      </select>
    </div>
    <div class="mb-3"><label class="form-label" for="date">Дата мероприятия</label><input class="form-control" type="date" name="date_start" id="date" min="<%= today %>" value="<%= form.date_start || '' %>" required></div>
    <div class="mb-3"><label class="form-label" for="method">Способ оплаты</label>
      <select class="form-select" id="method" name="payment" required>
        <option value="">Выберите способ оплаты</option>
        <% methods.forEach(method => { %><option value="<%= method %>" <%= form.payment === method ? 'selected' : '' %>><%= method %></option><% }) %>
      </select>
    </div>
    <button type="submit" class="btn btn-primary">Отправить заявку</button>
  </form>
  <p class="mt-3"><a href="/dashboard">Вернуться к моим заявкам</a></p>
</div></div>
<%- include('footer') %>
