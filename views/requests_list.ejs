<%- include('header', { title: isAdmin ? 'Админ-панель' : 'Мои заявки' }) %>
<div class="d-flex flex-wrap gap-3 justify-content-between align-items-center mb-3">
  <h1 class="h2 mb-0"><%= isAdmin ? 'Заявки пользователей' : 'Мои заявки' %> (<%= requests.length %>)</h1>
  <% if (!isAdmin) { %><a class="btn btn-success" href="/create">+ Новая заявка</a><% } %>
</div>
<% if (!requests.length) { %><p class="alert alert-info">Заявок пока нет.</p><% } %>
<div class="row">
  <% requests.forEach(item => { %>
    <div class="col-md-6 col-12 mb-3">
      <div class="card h-100">
        <div class="card-body">
          <div class="d-flex flex-wrap gap-2 justify-content-between align-items-start">
            <h2 class="h5"><%= item.room_name %></h2>
            <span class="badge <%= item.status === 'Новая' ? 'text-bg-secondary' : item.status === 'Мероприятие назначено' ? 'text-bg-primary' : item.status === 'Завершено' ? 'text-bg-success' : 'text-bg-danger' %>"><%= item.status %></span>
          </div>
          <% if (isAdmin) { %><p class="mb-1"><b>Пользователь:</b> <%= item.user_fio %> (<%= item.user_login %>)</p><% } %>
          <p class="mb-1"><b>Дата:</b> <%= item.date_start %></p>
          <p class="mb-1"><b>Способ оплаты:</b> <%= item.payment %></p>
          <p class="mb-3"><b>Отметка об оплате:</b> <%= item.payment_status || 'Не оплачено' %></p>
          <a class="btn btn-sm btn-outline-primary" href="/request/<%= item.id %>">Подробнее</a>
          <% if (isAdmin) { %>
            <form method="POST" action="/admin" class="d-flex flex-column flex-sm-row gap-2 mt-3">
              <input type="hidden" name="id" value="<%= item.id %>">
              <select class="form-select form-select-sm" name="status" aria-label="Статус заявки №<%= item.id %>">
                <% statuses.forEach(status => { %><option value="<%= status %>" <%= status === item.status ? 'selected' : '' %>><%= status %></option><% }) %>
              </select>
              <button class="btn btn-sm btn-primary" type="submit">Сохранить</button>
            </form>
          <% } %>
        </div>
      </div>
    </div>
  <% }) %>
</div>
<%- include('footer') %>
